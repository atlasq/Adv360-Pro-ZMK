#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_nb.h"

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LA(NUHS)  &kp N1          &kp N2        &kp N3          &kp N4           &kp N5  &kp N6                                                              &kp NUMBER_5  &kp N6  &kp N7  &kp N8     &kp N9       &kp N0         &kp MINUS
&kp TAB       &kp Q           &kp W         &kp E           &kp R            &kp T   &kp Y                                                               &kp T         &kp Y   &kp U   &kp I      &kp O        &kp P          &kp NB_A_RING
&kp ESC       &kp A           &kp S         &kp D           &kp F            &kp G   &kp H      &kp PAGE_DOWN  &kp PAGE_UP      &mo 2         &tog 1     &kp G         &kp H   &kp J   &kp K      &kp L        &kp NB_AE      &kp NB_O_SLASH
&kp LSHFT     &kp Z           &kp X         &kp C           &kp V            &kp B                             &kp HOME         &kp LEFT_GUI                           &kp N   &kp M   &kp COMMA  &kp DOT      &kp FSLH       &kp NB_BSLH
&kp LEFT_ALT  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW          &kp SPACE  &kp LGUI       &kp END          &kp DELETE    &kp ENTER  &kp BSPC              &none   &none      &kp NB_APOS  &kp NB_UMLAUT  &kp NB_LESS_THAN
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none  &none  &none  &none  &none  &none  &trans                                             &none      &none  &none      &none      &none       &none  &none
&none  &none  &none  &none  &none  &none  &none                                              &none      &none  &kp KP_N7  &kp KP_N8  &kp KP_N9   &none  &none
&none  &none  &none  &none  &none  &none  &none   &none  &none      &to 0         &mo 1      &none      &none  &kp KP_N4  &kp KP_N5  &kp KP_N6   &none  &none
&none  &none  &none  &none  &none  &none                 &none      &kp LEFT_GUI                        &none  &kp KP_N1  &kp KP_N2  &kp KP_N3   &none  &none
&none  &none  &none  &none  &none         &none   &none  &none      &kp LGUI      &kp ENTER  &kp KP_N0         &kp KP_N0  &kp DOT    &kp KP_DOT  &none  &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                             &trans           &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &bootloader                                       &bootloader      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none        &none  &none      &to 0  &mo 2       &none            &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                      &none      &none                               &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none        &none  &none      &none  &bl BL_TOG  &rgb_ug RGB_TOG         &none  &none  &none  &none  &none
            >;
        };
    };
};
